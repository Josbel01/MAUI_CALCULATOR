<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practica4_Calculadora_Daferlin.MainPage"
             Title="Calculadora">

    <Grid Padding="20" RowSpacing="10" ColumnSpacing="10"
          RowDefinitions="Auto,*,*,*,*,*"
          ColumnDefinitions="*,*,*,*">

        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="24" />
            </Style>
        </Grid.Resources>

        <!-- Fila 0: Display -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#F5F5F5"
                Stroke="Transparent" StrokeShape="RoundRectangle 10"
                Padding="15" Margin="0,0,0,20">
            <Label x:Name="lblDisplay" Text="0" FontSize="48"
                   HorizontalOptions="End" VerticalOptions="Center"
                   TextColor="Black" LineBreakMode="NoWrap" />
        </Border>

        <!-- Fila 1: C, ÷, ×, - -->
        <Button Grid.Row="1" Grid.Column="0" Text="C" BackgroundColor="#FF6B6B" TextColor="White" Clicked="OnClearClicked" />
        <Button Grid.Row="1" Grid.Column="1" Text="÷" BackgroundColor="#4ECDC4" TextColor="White" Clicked="OnOperatorClicked" />
        <Button Grid.Row="1" Grid.Column="2" Text="×" BackgroundColor="#4ECDC4" TextColor="White" Clicked="OnOperatorClicked" />
        <Button Grid.Row="1" Grid.Column="3" Text="-" BackgroundColor="#4ECDC4" TextColor="White" Clicked="OnOperatorClicked" />

        <!-- Fila 2: 7, 8, 9, + -->
        <Button Grid.Row="2" Grid.Column="0" Text="7" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="2" Grid.Column="1" Text="8" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="2" Grid.Column="2" Text="9" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="2" Grid.Column="3" Text="+" BackgroundColor="#4ECDC4" TextColor="White" Clicked="OnOperatorClicked" />

        <!-- Fila 3: 4, 5, 6 -->
        <Button Grid.Row="3" Grid.Column="0" Text="4" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="3" Grid.Column="1" Text="5" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="3" Grid.Column="2" Text="6" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />

        <!-- Fila 4: 1, 2, 3 -->
        <Button Grid.Row="4" Grid.Column="0" Text="1" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="4" Grid.Column="1" Text="2" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="4" Grid.Column="2" Text="3" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />

        <!-- Fila 5: 0 (2 columnas), . -->
        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="0" BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />
        <Button Grid.Row="5" Grid.Column="2" Text="." BackgroundColor="#95E1D3" TextColor="Black" Clicked="OnNumberClicked" />

        <!-- "=" ocupa filas 3 a 5, columna 3 -->
        <Button Grid.Row="3" Grid.Column="3" Grid.RowSpan="3" Text="="
                FontSize="32" FontAttributes="Bold"
                BackgroundColor="#0078D4" TextColor="White" Clicked="OnEqualsClicked" />
    </Grid>
</ContentPage>